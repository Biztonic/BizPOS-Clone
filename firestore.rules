rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null && 
        (!('firebase' in request.auth.token) || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    // Server-Controlled Platform Admin Authorization
    function isSuperAdmin() {
      return request.auth != null && (
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
        (
          exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/platform_admins/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
    }

    // Server-Authoritative Store Membership Verification
    function isStoreMember(storeId) {
      let memberPath = /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid);
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return isSuperAdmin() || (
        isAuthenticated() && (
          (exists(memberPath) && get(memberPath).data.status == 'ACTIVE') ||
          (!exists(memberPath) && exists(storePath) && 'owner' in get(storePath).data && get(storePath).data.owner == request.auth.uid)
        )
      );
    }

    function isStoreOwnerOrManager(storeId) {
      let memberPath = /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid);
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return isSuperAdmin() || (
        isAuthenticated() && (
          (
            exists(memberPath) && 
            get(memberPath).data.status == 'ACTIVE' &&
            'role' in get(memberPath).data &&
            (get(memberPath).data.role == 'Owner' || get(memberPath).data.role == 'Store Owner' || get(memberPath).data.role == 'Manager')
          ) ||
          (!exists(memberPath) && exists(storePath) && 'owner' in get(storePath).data && get(storePath).data.owner == request.auth.uid)
        )
      );
    }

    function isStoreOwner(storeId) {
      let memberPath = /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid);
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return isSuperAdmin() || (
        isAuthenticated() && (
          (
            exists(memberPath) && 
            get(memberPath).data.status == 'ACTIVE' &&
            'role' in get(memberPath).data &&
            (get(memberPath).data.role == 'Owner' || get(memberPath).data.role == 'Store Owner')
          ) ||
          (!exists(memberPath) && exists(storePath) && 'owner' in get(storePath).data && get(storePath).data.owner == request.auth.uid)
        )
      );
    }

    function storeAccess(storeId) {
      return isStoreMember(storeId);
    }

    function isStoreActive(storeId) {
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return isSuperAdmin() || (
        exists(storePath) &&
        (!('subscriptionStatus' in get(storePath).data) || 
         (get(storePath).data.subscriptionStatus != 'SUSPENDED' && get(storePath).data.subscriptionStatus != 'CANCELLED'))
      );
    }

    function storeHasFeature(storeId, feature) {
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return isSuperAdmin() || (
        exists(storePath) && (
          ('subscriptionPlan' in get(storePath).data && 
           get(storePath).data.subscriptionPlan in ['Standard', 'Professional', 'Enterprise', 'standard', 'professional', 'enterprise']) ||
          ('addons' in get(storePath).data && feature in get(storePath).data.addons) ||
          ('purchasedAddons' in get(storePath).data && feature in get(storePath).data.purchasedAddons)
        )
      );
    }

    // --- Collection Rules ---

    // 1. Users Collection (USER_PRIVATE)
    match /users/{uid} {
      // Must be authenticated and either own profile or Super Admin
      allow get: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == uid &&
          (!('role' in request.resource.data) || 
           (request.resource.data.role != 'Super Admin' && 
            request.resource.data.role != 'super_admin' && 
            request.resource.data.role != 'Admin'))
        )
      );

      // Normal users CANNOT modify privileged authorization fields
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == uid && 
        (!('role' in request.resource.data) || ('role' in resource.data && request.resource.data.role == resource.data.role)) &&
        (!('storeId' in request.resource.data) || ('storeId' in resource.data && request.resource.data.storeId == resource.data.storeId)) &&
        (!('storeIds' in request.resource.data) || ('storeIds' in resource.data && request.resource.data.storeIds == resource.data.storeIds)) &&
        (!('accessibleStoreIds' in request.resource.data) || ('accessibleStoreIds' in resource.data && request.resource.data.accessibleStoreIds == resource.data.accessibleStoreIds)) &&
        (!('franchiseId' in request.resource.data) || ('franchiseId' in resource.data && request.resource.data.franchiseId == resource.data.franchiseId)) &&
        (!('isSuperAdmin' in request.resource.data) || ('isSuperAdmin' in resource.data && request.resource.data.isSuperAdmin == resource.data.isSuperAdmin))
      );

      allow delete: if isSuperAdmin();
    }

    // 2. Stores Collection (STORE_PRIVATE)
    match /stores/{storeId} {
      allow get: if isSuperAdmin() || isStoreMember(storeId);
      allow list: if isSuperAdmin() || (isAuthenticated() && resource.data.owner == request.auth.uid);
      allow create: if isAuthenticated() && 
                    request.resource.data.owner == request.auth.uid &&
                    // Restrict baseline plan initialization for non-super-admins
                    (isSuperAdmin() || (
                      (!('subscriptionPlan' in request.resource.data) || 
                       request.resource.data.subscriptionPlan in ['Starting', 'Basic', 'starting', 'basic']) &&
                      (!('addons' in request.resource.data) || request.resource.data.addons.size() == 0) &&
                      (!('purchasedAddons' in request.resource.data) || request.resource.data.purchasedAddons.size() == 0)
                    ));
      allow update: if isSuperAdmin() || (
        isStoreOwnerOrManager(storeId) &&
        // Store ID must be immutable
        (!('id' in request.resource.data) || request.resource.data.id == storeId) &&
        // Anti-Bypass: Non-super-admins CANNOT alter subscription, plan, or entitlement fields
        (!('subscriptionPlan' in request.resource.data) || request.resource.data.subscriptionPlan == resource.data.subscriptionPlan) &&
        (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == resource.data.subscriptionStatus) &&
        (!('subscriptionExpiry' in request.resource.data) || request.resource.data.subscriptionExpiry == resource.data.subscriptionExpiry) &&
        (!('purchasedAddons' in request.resource.data) || request.resource.data.purchasedAddons == resource.data.purchasedAddons) &&
        (!('addons' in request.resource.data) || 
         request.resource.data.addons == resource.data.addons ||
         ('purchasedAddons' in resource.data && request.resource.data.addons.hasOnly(resource.data.purchasedAddons))) &&
        (!('entitlements' in request.resource.data) || request.resource.data.entitlements == resource.data.entitlements) &&
        (!('entitlementVersion' in request.resource.data) || request.resource.data.entitlementVersion == resource.data.entitlementVersion)
      );
      allow delete: if isSuperAdmin();
      
      // Server-Authoritative Canonical Entitlements
      match /entitlements/{docId} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin();
      }

      // Server-Controlled Store Membership Model
      match /members/{memberUid} {
        allow get, list: if isSuperAdmin() || isStoreMember(storeId);

        allow create: if isSuperAdmin() || (
          isAuthenticated() && (
            // Initial store creator creates own Owner membership
            (
              request.auth.uid == memberUid && 
              get(/databases/$(database)/documents/stores/$(storeId)).data.owner == request.auth.uid &&
              request.resource.data.role != 'Super Admin' &&
              request.resource.data.role != 'super_admin'
            ) ||
            // Active Owner adding team member
            (
              isStoreOwner(storeId) &&
              request.auth.uid != memberUid &&
              request.resource.data.role != 'Super Admin' &&
              request.resource.data.role != 'super_admin'
            ) ||
            // Active Manager adding non-owner team member (cannot assign Owner or Super Admin)
            (
              isStoreOwnerOrManager(storeId) &&
              !isStoreOwner(storeId) &&
              request.auth.uid != memberUid &&
              request.resource.data.role != 'Owner' &&
              request.resource.data.role != 'Store Owner' &&
              request.resource.data.role != 'Super Admin' &&
              request.resource.data.role != 'super_admin'
            )
          )
        );

        allow update: if isSuperAdmin() || (
          // Store Owner updating member (cannot self-modify or promote to Super Admin)
          (
            isStoreOwner(storeId) &&
            request.auth.uid != memberUid &&
            request.resource.data.role != 'Super Admin' &&
            request.resource.data.role != 'super_admin'
          ) ||
          // Manager updating member (cannot self-modify, cannot touch Owner role, cannot promote to Owner or Super Admin)
          (
            isStoreOwnerOrManager(storeId) &&
            !isStoreOwner(storeId) &&
            request.auth.uid != memberUid &&
            resource.data.role != 'Owner' &&
            resource.data.role != 'Store Owner' &&
            request.resource.data.role != 'Owner' &&
            request.resource.data.role != 'Store Owner' &&
            request.resource.data.role != 'Super Admin' &&
            request.resource.data.role != 'super_admin'
          )
        );

        allow delete: if isSuperAdmin() || (
          isStoreOwner(storeId) &&
          request.auth.uid != memberUid
        );
      }

      // Explicit Subcollections replacing broad wildcard
      match /counters/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
      }

      match /tables/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
      }

      match /floors/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
      }

      match /employees/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
      }

      match /settings/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
      }

      match /devices/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
      }

      match /shifts/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow create, update: if isSuperAdmin() || isStoreMember(storeId);
        allow delete: if isSuperAdmin() || isStoreOwner(storeId);
      }

      match /attendance/{id} {
        allow read: if isSuperAdmin() || isStoreMember(storeId);
        allow create, update: if isSuperAdmin() || isStoreMember(storeId);
        allow delete: if isSuperAdmin() || isStoreOwner(storeId);
      }
    }

    // 3. Platform Admins (PLATFORM_ADMIN)
    match /platform_admins/{adminUid} {
      allow read: if isSuperAdmin();
      allow write: if false; // Strictly server-side via Firebase Admin SDK
    }

    // 4. Franchises (FRANCHISE_PRIVATE)
    match /franchises/{franchiseId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow write: if isSuperAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // 5. Settings / Admin Config (PLATFORM_ADMIN / STORE_PRIVATE)
    match /settings/admin_config {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /settings/platform_limits {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /settings/metadata {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Settings for a specific store (STORE_PRIVATE)
    match /settings/{storeId} {
      allow read: if isSuperAdmin() || isStoreMember(storeId);
      allow write: if isSuperAdmin() || isStoreOwnerOrManager(storeId);
    }

    // 6. Subscription System (USER_PRIVATE / STORE_PRIVATE / PLATFORM_ADMIN)
    match /subscription_requests/{docId} {
      // User can only read their own subscription requests; Super Admin reads all
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.ownerEmail == request.auth.token.email
        )
      );
      // Regular authenticated users can submit new PENDING requests for themselves
      allow create: if isAuthenticated() && 
                    request.resource.data.status == 'PENDING' &&
                    (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
      // Only Super Admin can approve, modify, or delete subscription requests
      allow update, delete: if isSuperAdmin();
    }

    match /subscription_history/{histId} {
      allow read: if resource.data.storeId != null && isStoreMember(resource.data.storeId); 
      allow write: if isSuperAdmin();
    }

    // 7. Addon Reviews (PUBLIC)
    match /addon_reviews/{reviewId} {
      allow read: if true; // Publicly viewable
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 8. Central Catalog (PLATFORM_ADMIN)
    match /central_catalog/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // 9. Root Collections with storeId filtering (STORE_PRIVATE)
    match /orders/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (
        request.resource.data.storeId != null && 
        isStoreMember(request.resource.data.storeId) &&
        isStoreActive(request.resource.data.storeId)
      );
      allow update: if isSuperAdmin() || (
        resource.data.storeId != null && 
        isStoreMember(resource.data.storeId) && 
        request.resource.data.storeId == resource.data.storeId &&
        // Financial integrity: finalized orders cannot have financial totals or items tampered with
        (
          !(resource.data.status in ['Completed', 'PAID', 'VOID', 'Refunded']) ||
          (
            request.resource.data.total == resource.data.total &&
            (!('subtotal' in request.resource.data) || request.resource.data.subtotal == resource.data.subtotal) &&
            (!('items' in request.resource.data) || request.resource.data.items == resource.data.items)
          )
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /inventory/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (
        request.resource.data.storeId != null && 
        isStoreMember(request.resource.data.storeId) &&
        isStoreActive(request.resource.data.storeId)
      );
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    match /customers/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (
        request.resource.data.storeId != null && 
        isStoreMember(request.resource.data.storeId) &&
        isStoreActive(request.resource.data.storeId)
      );
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    match /inventory_movements/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreMember(request.resource.data.storeId));
      // Append-only ledger
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /business_events/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreMember(request.resource.data.storeId));
      // Append-only ledger
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /activity_logs/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreMember(request.resource.data.storeId));
      // Append-only audit log
      allow update, delete: if false;
    }

    match /counters/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreMember(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    match /suppliers/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreMember(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    match /notes/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreMember(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }
    
    match /employees/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwnerOrManager(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    match /floors/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (
        request.resource.data.storeId != null && 
        isStoreOwnerOrManager(request.resource.data.storeId) &&
        isStoreActive(request.resource.data.storeId) &&
        storeHasFeature(request.resource.data.storeId, 'floors')
      );
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    match /tables/{id} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreMember(resource.data.storeId));
      allow create: if isSuperAdmin() || (
        request.resource.data.storeId != null && 
        isStoreOwnerOrManager(request.resource.data.storeId) &&
        isStoreActive(request.resource.data.storeId) &&
        storeHasFeature(request.resource.data.storeId, 'tables')
      );
      allow update: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId) && 
                                           request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwnerOrManager(resource.data.storeId));
    }

    // 10. Roles Collection (PLATFORM_ADMIN)
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 11. Leads Collection (PUBLIC WITH STRICT VALIDATION)
    match /leads/{leadId} {
      allow create: if (
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt', 'storeName', 'source', 'notes']) &&
        'name' in request.resource.data && request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        'phone' in request.resource.data && request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 25 &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 150)) &&
        (!('storeName' in request.resource.data) || (request.resource.data.storeName is string && request.resource.data.storeName.size() <= 150)) &&
        (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 50))
      );
      allow read, update, delete: if isSuperAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
